@{
    ViewData["Title"] = "Categorias";
}
<div class="iq-card" style="background-color: #0B141A">
    <div class="iq-card-header d-flex justify-content-between align-items-center">
        <div class="iq-header-title">
            <h4 class="card-title text-white">Lista de Categorias Ativas</h4>
        </div>
        <div>
            <button type="button" data-toggle="modal" data-target="#modalCadastrarCategoria" class="btn dark-icon btn-primary mb-3">Adicionar Categorias <i class="ri-add-box-line"></i></button>
        </div>

    </div>
    <div class="iq-card-body">
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <select asp-items="@ViewBag.categorias" id="categoriaId" class="form-control" required style="width: 100%">
                        <option value="">Selecione uma Categoria</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="tableDetalhes"></div>




<partial name="_ModalCadastrarCategoria.cshtml" />
<partial name="_ModalCadastrarSubCategoria.cshtml" />
<script src="~/assets/js/categoria.js" charset="UTF-8"></script>
