
<div id="modalCadastrarCategoria" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenteredScrollableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenteredScrollableTitle">Cadastrar Categoria</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form class="was-validated" id="salvarCategoria" asp-action="Gravar" method="post">             
                <div class="modal-body">                   
                    <div class="form-group">
                        <div class="mb-3">
                            <input type="text" name="Descricao" id="Descricao" maxlength="100" class="form-control is-invalid"  placeholder="Nome da categoria" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" style="width: 80px" class="btn btn-danger" data-dismiss="modal">sair</button>
                    <button type="button" style="width: 80px" class="btn btn-primary btn-salvar">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>