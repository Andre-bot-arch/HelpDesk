
<div id="modalCadastrarSubCategoria" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenteredScrollableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenteredScrollableTitle">Cadastrar Sub Categoria</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form class="was-validated" id="salvarSubCategoria" asp-action="Gravar" method="post">             
                <div class="modal-body">
                    <input type="hidden" name="FkCategoria" id="_FkCategoria" />
                    <div class="form-group">
                        <div class="mb-3">
                            <input type="text" autocomplete="off" name="Descricao" id="_Descricao" maxlength="100" class="form-control is-invalid"  placeholder="Nome da categoria" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <select class="custom-select" name="Prioridade" required="">
                            <option value="">Selecione uma Prioridade</option>
                            <option class="text-dark" value="Normal">NORMAL</option>
                            <option class="text-warning" value="Media">MEDIA</option>
                            <option class="text-danger" value="Alta">ALTA  </option>
                            <option value="Urgente">URGENTE</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <select class="custom-select" name="Complexidade" required="">
                            <option value="">Selecione a Complexidade</option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" style="width: 80px" class="btn btn-danger" data-dismiss="modal">sair</button>
                    <button type="button" style="width: 80px" class="btn btn-primary btn-salvar-sub">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>