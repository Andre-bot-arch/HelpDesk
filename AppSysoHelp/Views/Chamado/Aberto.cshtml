@model IEnumerable<AppSysoHelp.Models.Chamados> 
<div class="iq-card" style="background-color: #111b21">
    <div class="iq-card-header d-flex justify-content-between">
        <div class="iq-header-title">
            <h4 class="text-white">Chamados - @DateTime.Now.ToString("dd/MM/yyyy")</h4>
        </div>
        <div class="text-end">
            <button type="button" data-toggle="modal" data-target="#modalCadastroChamado" class="btn dark-icon btn-primary mb-3">Adicionar <i class="ri-add-box-line"></i></button>
        </div>
    </div>
    <div class="iq-card-body">       
        <ul class="nav nav-tabs justify-content-end" id="myTab-4" role="tablist">
            <li class="nav-item">
                <a class="nav-link text-primary active" id="interno-tab-end" data-toggle="tab" href="#interno-end" role="tab" aria-controls="interno" aria-selected="false">Internos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-primary" id="externo-tab-end" data-toggle="tab" href="#externo-end" role="tab" aria-controls="externo" aria-selected="false">Externo</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-primary" id="vector-tab-end" data-toggle="tab" href="#vector-end" role="tab" aria-controls="vector" aria-selected="true">Vector</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-primary" id="desenvolvimento-tab-end" data-toggle="tab" href="#desenvolvimento-end" role="tab" aria-controls="desenvolvimento" aria-selected="false">Desenvolvimento</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-primary" id="financeiro-tab-end" data-toggle="tab" href="#financeiro-end" role="tab" aria-controls="financeiro" aria-selected="false">Financeiro</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-primary" id="treinamento-tab-end" data-toggle="tab" href="#treinamento-end" role="tab" aria-controls="treinamento" aria-selected="true">Treinamento</a>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent-5">
            <partial name="_PartialInterno.cshtml" model="@Model.Where(a=> a.FkSetores == 1)" />
            <partial name="_PartialExterno.cshtml" model="@Model.Where(a=> a.FkSetores == 2)" />
            <partial name="_PartialVector.cshtml" model="@Model.Where(a=> a.FkSetores == 3)"/>
            <partial name="_PartialDevelop.cshtml" model="@Model.Where(a=> a.FkSetores == 4)" />
            <partial name="_PartialFinanceiro.cshtml" model="@Model.Where(a=> a.FkSetores == 5)" />
            <partial name="_PartialTreinamento.cshtml" model="@Model.Where(a=> a.FkSetores == 6)" />
        </div>
    </div>
</div>

<partial name="_ModalCadastrarChamado.cshtml" />
<partial name="_ModalRemarcarChamado.cshtml" />
<partial name="_ModalCancelarChamado.cshtml" />
 <partial name="_ModalPrintChamado.cshtml" model="new Chamados()" />  

<script>
    $(document).ready(function () {
        $(".btn-adicionarIdPrint").click(function () {
            var id = $(this).data("id");
            $("#modalContentContainer").html("");
            $.ajax({
                url: '/Chamado/BuscarDetalhes',
                type: 'POST',
                data: { id: id},
                success: function (response) {
                    console.log(response);
                    $("#modalContentContainer").html(response);                   
                    $("#modalPrintChamado").modal("show");
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Erro!',
                        text: 'Ocorreu um erro inesperado.',
                        confirmButtonText: 'OK'
                    });
                }

            });
        });
    });

</script>