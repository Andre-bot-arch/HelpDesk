@model AppSysoHelp.Models.Chamados
@{
}
<form class="was-validated" asp-action="CancelarChamado" method="post">
    <div class="modal-body">
        <div class="row">
            <div class="col-sm-3">
                <label for="exampleInputText1" class="text-primary">
                    Protocolo: <br />
                    <span class="text-dark"> @Model.ChamadoId</span>
                </label>
            </div>
            <div class="col-sm-3">
                <label for="exampleInputText1" class="text-primary">
                    Abertura:<br />
                    <span class="text-dark">@Convert.ToDateTime(Model.DataCriacao).ToString("dd/MM/yyyy hh:mm")</span>
                </label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">
                    Programação do Atendimento:<br />
                    <span class="text-dark"> @Convert.ToDateTime(Model.DataAgendamento).ToString("dd/MM/yyyy hh:mm")</span>
                </label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">Cliente: <br /> <span class="text-dark">@Model.FkCliente.NomeCliente</span></label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">
                    Contato:<br />
                    <span class="text-dark"> @Model.Contato - @Model.TelefoneContato</span>
                </label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">Prioridade:<br /> <span class="text-dark"> @Model.Prioridade</span></label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">
                    Registro do Chamado:<br />
                    <span class="text-dark">@Model.FkAtendenteNavigation.NomeCompleto</span>
                </label>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <label for="exampleInputText1" class="text-primary"> Solicitação: </label><br />
                <label for="exampleInputText1" style="text-align:justify">@Model.DescricaoCompleta</label>
            </div>
        </div>
        <div>
            <div class="alert alert-success" role="alert">
                <div class="iq-alert-icon">
                    <i class="ri-alert-line"></i>
                </div>
                <div class="iq-alert-text"><b>Resumo do Atendimento!</b> </div>
            </div>
        </div>
        <div>
            <div class="iq-card">
                <div class="iq-card-body">
                    <ul class="iq-timeline">
                        @foreach (var item in Model.Atendimentos)
                        {
                            <li>
                                <div class="timeline-dots"></div>
                                <h6 class="float-left mb-1">@item.FkTecnico.NomeCompleto</h6>
                                <small class="float-right mt-1 text-primary">@Convert.ToDateTime(item.DataAtendimento).ToString("dd/MM/yyyy HH:mm")</small>
                                <div class="d-inline-block w-100">
                                    <p>@item.ProcedimentosAplicados</p>
                                    @if (!String.IsNullOrEmpty(item.CaminhoDaImagem))
                                    {
                                        <small class="btn btn-link text-primary float-right toggle-embed" style="margin-bottom: 15px" data-id="@item.AtendimentoId">Visualizar arquivo</small>
                                    }
                                </div>
                                <hr />
                                <div class="embed-responsive embed-responsive-16by9 embed-container" data-id="@item.AtendimentoId" style="display: none;">
                                    <a href="~/@item.CaminhoDaImagem" target="_blank" data-bs-toggle="tooltip" title="Clique para visualizar o arquivo original">
                                        <embed src="~/@item.CaminhoDaImagem" class="embed-responsive-item" />
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
    </div>
</form>

<script>
    $(document).ready(function () {
        $('[data-bs-toggle="tooltip"]').tooltip();
        $('.toggle-embed').on('click', function () {
            const id = $(this).data('id'); // Pega o ID associado ao botão
            const embedContainer = $(`.embed-container[data-id="${id}"]`); // Localiza o embed correspondente

            // Alterna a exibição do embed
            embedContainer.toggle();

            // Atualiza o texto do botão com base no estado
            const isVisible = embedContainer.is(':visible');
            $(this).text(isVisible ? 'Fechar arquivo' : 'Visualizar arquivo');
        });
    });
</script>