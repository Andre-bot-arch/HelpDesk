@model AppSysoHelp.Models.Chamados
@{
}
<form class="was-validated" asp-action="CancelarChamado" method="post">
    <div class="modal-body">
        <div class="row">
            <div class="col-sm-6">

                <label for="exampleInputText1" class="text-primary">
                    Protocolo: <br />
                    <span class="text-dark"> @Model.ChamadoId</span>
                </label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">
                    Abertura:<br />
                    <span class="text-dark">@Convert.ToDateTime(Model.DataCriacao).ToString("dd/MM/yyyy hh:mm")</span>
                </label>

            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">Cliente: <br /> <span class="text-dark">@Model.FkCliente.NomeCliente</span></label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">
                    Programação:<br />
                    <span class="text-dark"> @Convert.ToDateTime(Model.DataAgendamento).ToString("dd/MM/yyyy hh:mm")</span>
                </label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">Prioridade:<br /> <span class="text-dark"> @Model.Prioridade</span></label>
            </div>
            <div class="col-sm-6">
                <label for="exampleInputText1" class="text-primary">
                    Registro do Chamado:<br />
                    <span class="text-dark">@Model.FkAtendenteNavigation.NomeCompleto</span>
                </label>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <label for="exampleInputText1" class="text-primary"> Solicitação: </label><br />
                <label for="exampleInputText1" style="text-align:justify">@Model.DescricaoCompleta</label>
            </div>
        </div>
        <div>
            <div class="alert alert-success" role="alert">
                <div class="iq-alert-icon">
                    <i class="ri-alert-line"></i>
                </div>
                <div class="iq-alert-text"><b>Resumo do Atendimento!</b> </div>
            </div>
        </div>
        <div>
            <div class="iq-card">
                <div class="iq-card-body">
                    <ul class="iq-timeline">
                        @foreach (var item in Model.Atendimentos)
                        {
                            <li>
                                <div class="timeline-dots"></div>
                                <h6 class="float-left mb-1">@item.FkTecnico.NomeCompleto</h6>
                                <small class="float-right mt-1 text-primary">@Convert.ToDateTime(item.DataAtendimento).ToString("dd/MM/yyyy hh:mm")</small>
                                <div class="d-inline-block w-100">
                                    <p>@item.ProcedimentosAplicados</p>
                                </div>
                            </li>
                        }

                        @*   <li>
                        <div class="timeline-dots border-success"></div>
                        <h6 class="float-left mb-1">Client Meeting</h6>
                        <small class="float-right mt-1">19 November 2019</small>
                        <div class="d-inline-block w-100">
                        <p>Bonbon macaroon jelly beans gummi bears jelly lollipop apple</p>
                        </div>
                        </li>
                        *@
                    </ul>
                </div>
            </div>
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
    </div>
</form>

