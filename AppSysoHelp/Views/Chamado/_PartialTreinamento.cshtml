        <!--Fechados-->
        <div class="tab-pane fade" id="pills-contact6-fill" role="tabpanel" aria-labelledby="pills-contact6-tab-fill">
            <table class="table table-striped mb-0 table-borderless" style="border-color: #222e35; ">
                <thead>
                    <tr sstyle="border-bottom: 1px solid #222e35;">
                        <th scope="col">Protocolo</th>
                        <th scope="col">Abertura</th>
                        <th scope="col">Atendimento</th>
                        <th scope="col" class="text-center">Prioridade</th>
                        <th scope="col">Finalizado Por:</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Where(a => (a.FkSituacaoChamadoId == 3 || a.FkSituacaoChamadoId == 4)))
                    {
                        var cancelado = "";
                        if (item.FkSituacaoChamadoId == 4)
                        {
                            cancelado = "text-danger";
                        }
                        <tr class="@cancelado">
                            <td>
                                 #@item.ChamadoId.ToString().PadLeft(8, '0')<br />@item.FkCliente.Fantasia<br/>
                                @item.FkCliente.NomeCliente
                            </td>
                            <td>@Convert.ToDateTime(item.DataAgendamento).ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (!String.IsNullOrEmpty(item.DataFechamento.ToString()))
                                {
                                    var dataUltimoAtendimento = Convert.ToDateTime(item.DataFechamento).ToString("dd/MM/yyyy HH:mm");
                                    @dataUltimoAtendimento
                                    ;
                                }
