                                {
                                    @item.Atendimentos.OrderByDescending(a => a.AtendimentoId).FirstOrDefault().FkTecnico.NomeCompleto.Substring(0, 8)
                                }
                                else
                                {
                                    <label class="text-white">-----------</label>
