@{
    ViewData["Title"] = "Chat WhatsApp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="chat-wrapper" style="height: calc(100vh - 70px); overflow: hidden;">
    <div class="row g-0 h-100">

        <!-- ============================================ -->
        <!-- COLUNA ESQUERDA - LISTA DE CONVERSAS -->
        <!-- ============================================ -->
        <div class="col-12 col-md-4 col-lg-3 border-end d-flex flex-column h-100" id="conversations-column">

            <!-- Header da lista -->
            <div class="bg-success text-white p-3 d-flex justify-content-between align-items-center flex-shrink-0">
                <h5 class="mb-0">
                    <i class="fab fa-whatsapp"></i> Conversas
                </h5>
                <span class="badge bg-light text-dark" id="conversation-count">0</span>
            </div>

            <!-- Busca -->
            <div class="p-2 border-bottom bg-light flex-shrink-0">
                <input type="text"
                       id="search-conversations"
                       class="form-control form-control-sm"
                       placeholder="🔍 Buscar conversa... ">
            </div>

            <!-- Lista de conversas -->
            <div id="conversations-list" class="flex-grow-1 overflow-auto bg-white">
                <div class="text-center text-muted py-5">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Carregando... </span>
                    </div>
                    <p class="mt-2 mb-0 small">Carregando conversas... </p>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- COLUNA DIREITA - ÁREA DO CHAT -->
        <!-- ============================================ -->
        <div class="col-12 col-md-8 col-lg-9 d-flex flex-column h-100" id="chat-column">

            <!-- Estado inicial - nenhuma conversa selecionada -->
            <div id="no-chat-selected" class="d-flex align-items-center justify-content-center h-100 bg-light">
                <div class="text-center text-muted">
                    <i class="fab fa-whatsapp fa-5x mb-3 text-success"></i>
                    <h4>WhatsApp HelpDesk</h4>
                    <p class="text-muted">Selecione uma conversa para começar o atendimento</p>
                </div>
            </div>

            <!-- Área do chat ativo (oculta inicialmente) -->
            <div id="active-chat" class="d-none flex-column h-100">

                <!-- Header do chat -->
                <div class="bg-light border-bottom p-3 d-flex justify-content-between align-items-center flex-shrink-0">
                    <!-- Botão voltar (apenas mobile) -->
                    <button class="btn btn-sm btn-outline-secondary d-md-none me-2" onclick="backToConversations()">
                        <i class="fas fa-arrow-left"></i>
                    </button>

                    <div class="d-flex align-items-center flex-grow-1">
                        <div class="avatar bg-success text-white rounded-circle me-3 d-flex align-items-center justify-content-center"
                             style="width: 45px; height: 45px; font-weight: bold; font-size: 18px; flex-shrink: 0;">
                            <span id="chat-avatar-initials">? </span>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="mb-0 fw-bold text-truncate" id="chat-customer-name">Cliente</h6>
                            <small class="text-muted text-truncate d-block" id="chat-phone-number"></small>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-shrink-0">
                        <button class="btn btn-sm btn-outline-primary" onclick="showConversationInfo()" title="Informações">
                            <i class="fas fa-info-circle"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary d-none d-md-inline-block" onclick="closeChat()" title="Fechar">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>

                <!-- Área de mensagens -->
                <div id="chat-messages" class="flex-grow-1 p-3 overflow-auto"
                     style="background-color: #e5ddd5; background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAFElEQVQYlWNgYGCQwoKxgqGgcJoAAA4hAsRVmXNEAAAAAElFTkSuQmCC');">
                    <!-- Mensagens serão inseridas aqui via JavaScript -->
                </div>

                <!-- Input de mensagem -->
                <div class="border-top p-3 bg-white flex-shrink-0">
                    <div class="input-group">
                        <input type="text"
                               id="message-input"
                               class="form-control"
                               placeholder="Digite sua mensagem..."
                               maxlength="4096"
                               autocomplete="off">
                        <button class="btn btn-success" type="button" id="send-button">
                            <i class="fas fa-paper-plane"></i>
                            <span class="d-none d-md-inline ms-1">Enviar</span>
                        </button>
                    </div>
                    <small class="text-muted d-none d-md-block">Pressione Enter para enviar</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de informações da conversa -->
<div class="modal fade" id="conversationInfoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle"></i> Informações da Conversa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="conversation-info-content">
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================ -->
<!-- CSS -->
<!-- ============================================ -->
<style>
    /* ========== LAYOUT GERAL ========== */
    body {
        overflow: hidden;
    }

    .chat-wrapper {
        position: relative;
        width: 100%;
    }

    /* Em mobile, ocultar coluna de conversas quando chat estiver aberto */
    @@media (max-width: 767px) {
        #conversations-column. hide-mobile {
            display: none !important;
        }

        #chat-column. show-mobile {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1000;
            background: white;
        }
    }

    /* ========== LISTA DE CONVERSAS ========== */
    #conversations-list {
        background-color: #ffffff;
    }

    .conversation-item {
        padding: 12px 15px;
        border-bottom: 1px solid #e0e0e0;
        cursor: pointer;
        transition: background-color 0.2s;
        display: flex;
        align-items: center;
    }

        .conversation-item:hover {
            background-color: #f5f5f5;
        }

        .conversation-item.active {
            background-color: #d1f4e0;
            border-left: 4px solid #25D366;
        }

    . conversation-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #25D366, #128C7E);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
        margin-right: 12px;
        flex-shrink: 0;
        text-transform: uppercase;
    }

    .conversation-info {
        flex: 1;
        min-width: 0;
        overflow: hidden;
    }

    .conversation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    . conversation-name {
        font-weight: 600;
        font-size: 15px;
        color: #000;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-time {
        font-size: 11px;
        color: #667781;
        white-space: nowrap;
        margin-left: 8px;
        flex-shrink: 0;
    }

    .conversation-last-message {
        font-size: 13px;
        color: #667781;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conversation-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .unread-badge {
        background-color: #25D366;
        color: white;
        border-radius: 12px;
        min-width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: bold;
        padding: 0 6px;
        flex-shrink: 0;
        margin-left: 8px;
    }

    /* ========== ÁREA DO CHAT ========== */
    #chat-messages {
        scroll-behavior: smooth;
    }

    /* Mensagens do cliente (esquerda) */
    .message-incoming {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 12px;
        animation: slideInLeft 0.3s ease;
    }

        .message-incoming . message-bubble {
            background-color: #ffffff;
            border-radius: 8px 8px 8px 0;
            padding: 8px 12px;
            max-width: 65%;
            box-shadow: 0 1px 0. 5px rgba(0, 0, 0, 0.13);
            position: relative;
        }

    /* Mensagens do técnico (direita) */
    .message-outgoing {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 12px;
        animation: slideInRight 0.3s ease;
    }

        .message-outgoing .message-bubble {
            background-color: #dcf8c6;
            border-radius: 8px 8px 0 8px;
            padding: 8px 12px;
            max-width: 65%;
            box-shadow: 0 1px 0.5px rgba(0, 0, 0, 0.13);
            position: relative;
        }

    /* Conteúdo da mensagem */
    .message-content {
        margin: 0;
        word-wrap: break-word;
        white-space: pre-wrap;
        color: #111;
        font-size: 14px;
        line-height: 1.4;
    }

    /* Informações da mensagem */
    .message-info {
        font-size: 11px;
        color: #667781;
        margin-top: 4px;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 4px;
    }

    /* Mídia nas mensagens */
    .message-media img,
    .message-media video {
        max-width: 100%;
        border-radius: 8px;
        margin-bottom: 4px;
        cursor: pointer;
    }

    .message-media audio {
        width: 100%;
        max-width: 300px;
    }

    /* Animações */
    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Scrollbar customizada */
    #conversations-list::-webkit-scrollbar,
    #chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    #conversations-list: :-webkit-scrollbar-track,
    #chat-messages::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    #conversations-list::-webkit-scrollbar-thumb,
    #chat-messages::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        #conversations-list::-webkit-scrollbar-thumb:hover,
        #chat-messages::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /* Avatar do header do chat */
    #chat-avatar-initials {
        text-transform: uppercase;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.14/dist/browser/signalr.min.js"></script>
    <script src="~/assets/js/whatsapp-chat.js"></script>
}