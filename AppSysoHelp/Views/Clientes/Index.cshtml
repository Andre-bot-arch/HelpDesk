@using X.Web.PagedList
@model X.PagedList.IPagedList<AppSysoHelp.Models.Clientes>
@{
    var query = ViewBag.Query;
    int currentPage = Model.PageNumber;
    int totalPages = Model.PageCount;
    int maxPagesToShow = 7; // Total de páginas a mostrar (3 para frente + 3 para trás + a página atual)
    int startPage = Math.Max(1, currentPage - 3);
    int endPage = Math.Min(totalPages, currentPage + 3);

    // Ajuste para mostrar o número correto de páginas quando há menos páginas no início ou no final
    if (endPage - startPage + 1 < maxPagesToShow)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(totalPages, endPage + (maxPagesToShow - (endPage - startPage + 1)));
        }
        else if (endPage == totalPages)
        {
            startPage = Math.Max(1, startPage - (maxPagesToShow - (endPage - startPage + 1)));
        }
    }
}
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
        background-color: #f4f4f4;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }

    table, th, td {
        border: 1px solid #ddd;
    }

    th, td {
        padding: 10px;
        text-align: left;
    }

    th {
        background-color: #BEB5E0;
        color: white;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    .collapse-content {
        display: none;
        padding: 10px;
        border-top: 1px solid #ddd;
        background-color: #fafafa;
    }

    .collapse-btn {
        cursor: pointer;
        background-color: #BEB5E0;
        color: white;
        border: none;
        padding: 5px 10px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
        margin: 5px 0;
        border-radius: 3px;
    }

    @@media screen and (max-width: 768px) {
        table, thead, tbody, th, td, tr {
            display: block;
        }

            thead tr {
                display: none;
            }

        tr {
            margin-bottom: 20px;
            border: 1px solid #ddd;
            padding: 10px;
            background-color: #fff;
            border-radius: 5px;
        }

        td {
            text-align: right;
            padding-left: 50%;
            position: relative;
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

            td::before {
                content: attr(data-label);
                position: absolute;
                left: 10px;
                width: 45%;
                padding-right: 10px;
                white-space: nowrap;
                text-align: left;
                font-weight: bold;
                color: #333;
            }

        .collapse-btn {
            display: block;
            width: 100%;
        }
    }
</style>

<div class="iq-card" style="background-color: #0B141A">
    <div class="iq-card-header d-flex justify-content-between align-items-center">
        <div class="iq-header-title">
            <h4 class="card-title text-primary"> Lista de Clientes</h4>
        </div>
        <form asp-action="Index" asp-controller="Clientes" class="d-flex align-items-center ml-auto">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Buscar cliente..." name="query" aria-label="Buscar cliente..." aria-describedby="button-addon2" style="border-color: #6546D2">
                <div class="input-group-append">
                    <button class="btn btn-outline-primary" type="submit" id="button-addon2" style="font-weight: bold; font-size: 1.3rem">
                        <i class="las la-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <div class="iq-card-body">
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="container mb-3">
                    <div class="card" style="background-color: #222e35">
                        <div class="card-header text-primary" style="background-color: #111b21">
                            <i class="las la-user-circle fa-lg"></i> @item.ClienteId - <b>@item.NomeCliente</b>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-9 col-md-8 mb-3 mb-md-0" style="color: lightgray">
                                    <p><strong>CNPJ:</strong> @item.Documento</p>
                                    <p><strong>Telefone:</strong> @item.TelefoneCliente</p>
                                    <p><strong>CEP:</strong> @item.Cep</p>
                                    <p><strong>Endereço:</strong> @item.Logradouro, @item.Bairro, @item.Cidade - @item.Uf</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <hr />
        </div>
    </div>
</div>
<div class="d-flex justify-content-center">
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, query = query })">Anterior</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Anterior</span>
            </li>
        }

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, query = query })">1</a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i, query = query })">@i</a>
            </li>
        }

        @if (endPage < totalPages)
        {
            @if (endPage < totalPages - 1)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = totalPages, query = query })">@totalPages</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, query = query })">Próxima</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Próxima</span>
            </li>
        }
    </ul>
</div>
<script>
    function toggleCollapse(button) {
        const row = button.parentElement.parentElement.nextElementSibling;
        const isExpanded = row.style.display === "table-row";
        row.style.display = isExpanded ? "none" : "table-row";
        button.textContent = isExpanded ? "Mostrar Endereço" : "Ocultar Endereço";
    }
</script>
