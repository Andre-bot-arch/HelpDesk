@model IEnumerable<AppSysoHelp.Models.Contratos>
@{
}
<div class="iq-card">
    <div class="iq-card-header d-flex justify-content-between">
        <div class="iq-header-title">
            <h4 class="card-title"> Lista de Contratos Ativos</h4>
        </div>
        <div class="text-end">
            <button type="button" data-toggle="modal" data-target="#exampleModalCenteredScrollable" class="btn dark-icon btn-primary mb-3">Adicionar <i class="ri-add-box-line"></i></button>
        </div>
    </div>
    <div class="iq-card-body">
        <div class="row">
            @foreach (var item in Model.GroupBy(a => a.FkClienteId))
            {
                <div class="container mt-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="card-header bg-light text-primary">
                                <i class="fa fa-address-book"></i> @item.FirstOrDefault().FkCliente.NomeCliente.ToUpper()
                            </div>                           
                            @foreach (var contrato in item)
                            {
                                <div class="row align-items-center">
                                    <div class="col-8">
                                        <label class="card-title">
                                            <span class="text-primary">@contrato.FkPlataforma.NomePlataforma:</span> @contrato.FkPlataforma.Descricao
                                            <br /> <span class="text-primary">
                                                Pontos: @contrato.PontosContratados
                                            </span>
                                            <br /> <span class="text-primary">Valor:</span> @contrato.Valor.ToString("C2")
                                        </label>
                                    </div>
                                    <div class="col-4 text-right d-flex justify-content-between">
                                        <button style="width: 45%" type="button" class="btn dark-icon btn-info btn-edit" data-id="@contrato.ContratoId">Editar <i class="ri-edit-box-fill"></i></button>
                                        <a style="width: 45%" href="~/Contrato/Detalhes" class="btn dark-icon btn-primary" data-id="@contrato.ContratoId">Detalhar <i class="ri-edit-box-fill"></i></a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <hr />
            }
        </div>

    </div>
</div>

<partial name="_ModalCadastrarContrato.cshtml" />
