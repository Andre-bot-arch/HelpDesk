
<div id="exampleModalCenteredScrollable" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenteredScrollableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenteredScrollableTitle">Cadastrar Contrato</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form class="was-validated" action="/" method="post">
                <div class="modal-body">
                    <div class="form-group">
                        <select class="custom-select" required>
                            <option value="">Selecione um Sistema</option>
                            <option value="1">One</option>
                            <option value="2">Two</option>
                            <option value="3">Three</option>
                        </select>
                        @*   <div class="invalid-feedback">Campo obrigatório</div> *@
                    </div>
                    <div class="form-group">
                        <select class="custom-select" required>
                            <option value="">Selecione um Cliente</option>
                            <option value="1">One</option>
                            <option value="2">Two</option>
                            <option value="3">Three</option>
                        </select>
                        @*   <div class="invalid-feedback">Campo obrigatório</div> *@
                    </div>

                    <div class="row">
                        <div class="col-sm-8">
                            <div class="mb-3">
                                <input type="text" maxlength="100" class="form-control is-invalid" id="validationTooltip01" placeholder="Detalhes do Contrato" required>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="mb-3">
                                <input type="number" class="form-control is-invalid" id="validationTooltip01" placeholder="Pontos" required>
                            </div>
                        </div>

                    </div>
                    <label>Vigência</label>
                    <div class="row">

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <input type="month" class="form-control is-invalid" id="exampleInputmonth" placeholder="Data Inicial" required>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <input type="month" class="form-control" id="exampleInputmonth" placeholder="Data Final">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" style="width: 80px" class="btn btn-danger" data-dismiss="modal">sair</button>
                    <button type="submit" style="width: 80px" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>
