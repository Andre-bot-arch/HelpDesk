    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title> Pagina não encontrada</title>
    <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.min.css'>
    <link rel='stylesheet' href='https://fonts.googleapis.com/css?family=Arvo'>
   

    <style>
        body {
            padding: 40px 0;
            background: #fff;
            font-family: "Arvo", serif;
            overflow: hidden;
        }

        .page_404 img {
            width: 100%;
        }

        .four_zero_four_bg {
            background-image: url('@Url.Content("~/images/error/bg.gif")');
            height: 500px;
            background-position: center;
        }

            .four_zero_four_bg h1 {
                font-size: 80px;
            }

            .four_zero_four_bg h3 {
                font-size: 80px;
            }

        .link_404 {
            color: #fff !important;
            padding: 10px 20px;
            background: #39ac31;
            margin: 20px 0;
            display: inline-block;
        }

        .contant_box_404 {
            margin-top: -50px;
        }
    </style>

</head>
<body>

    <section class="page_404">
        <div class="container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="col-sm-10 col-sm-offset-1 text-center">
                        <div class="four_zero_four_bg">
                            <h1 class="text-center">404</h1>
                        </div>

                        <div class="contant_box_404">
                            <h3 class="h2">Parece que voce está perdido ?</h3>

                            <p>Pagina não disponivel!</p>

                          @*   <a href="Home/index" class="link_404">Go to Home</a> *@
