@{
    ViewData["Title"] = "Home";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div>
    <canvas id="chart" height="100"></canvas>
</div>
<div>
    <canvas id="rankingChart" height="100"></canvas>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        var ctx = document.getElementById('rankingChart').getContext('2d');

        // Requisição para obter os dados do ranking
        fetch('@Url.Action("AtendimentoRanking")')
            .then(response => response.json())
            .then(data => {
                console.log(data); // Verifique se os dados estão corretos

                // Processa os dados
                var technicians = {};
                data.forEach(item => {
                    if (!technicians[item.Tecnico]) {
                        technicians[item.Tecnico] = {};
                    }
                    if (!technicians[item.Tecnico][item.MêsAno]) {
                        technicians[item.Tecnico][item.MêsAno] = 0;
                    }
                    technicians[item.Tecnico][item.MêsAno] += item.Quantidade;
                });

                var labels = [];
                var datasets = [];
                for (const [technician, months] of Object.entries(technicians)) {
                    var dataValues = [];
                    for (const [month, count] of Object.entries(months)) {
                        if (!labels.includes(month)) {
                            labels.push(month);
                        }
                        dataValues.push(count);
                    }
                    datasets.push({
                        label: technician,
                        data: dataValues,
                        borderColor: randomColor(),
                        backgroundColor: 'rgba(0,0,0,0)',
                        borderWidth: 2,
                        fill: false
                    });
                }

                // Cria o gráfico
                new Chart(ctx, {
                    type: 'line', // Tipo de gráfico
                    data: {
                        labels: labels,
                        datasets: datasets
                    },
                    options: {
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Mês/Ano'
                                }
                            },
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Quantidade de Atendimentos'
                                }
                            }
                        }
                    }
                });
            })
            .catch(error => console.error('Erro ao obter dados do ranking:', error));

        // Função para gerar cores aleatórias
        function randomColor() {
            return 'rgba(' + Math.floor(Math.random() * 256) + ',' +
                Math.floor(Math.random() * 256) + ',' +
                Math.floor(Math.random() * 256) + ', 0.7)';
        }






        var ctx = document.getElementById('chart').getContext('2d');

        // Serializa os dados do modelo para JSON
        var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        // Processa e agrupa os dados por mês
        var labels = [];
        var openValues = [];
        var closedValues = [];
        var groupedOpenData = {};
        var groupedClosedData = {};
        var currentDate = new Date();
        var months = [];

        // Adiciona os últimos 6 meses ao array de meses
        for (var i = 0; i < 6; i++) {
            var monthYear = currentDate.getFullYear() + '-' + (currentDate.getMonth() + 1).toString().padStart(2, '0');
            months.unshift(monthYear);
            currentDate.setMonth(currentDate.getMonth() - 1);
        }

        // Preenche os objetos groupedData com zeros para cada mês dos últimos 6 meses
        months.forEach(function (monthYear) {
            groupedOpenData[monthYear] = 0;
            groupedClosedData[monthYear] = 0;
        });

        // Processa os dados para contar os chamados abertos e atendidos por mês
        data.forEach(function (item) {
            var dateCreated = new Date(item.DataCriacao);
            var monthYearCreated = dateCreated.getFullYear() + '-' + (dateCreated.getMonth() + 1).toString().padStart(2, '0');

            if (groupedOpenData[monthYearCreated] !== undefined) {
                groupedOpenData[monthYearCreated]++;
            }

            if (item.DataFechamento) {
                var dateClosed = new Date(item.DataFechamento);
                var monthYearClosed = dateClosed.getFullYear() + '-' + (dateClosed.getMonth() + 1).toString().padStart(2, '0');

                if (groupedClosedData[monthYearClosed] !== undefined) {
                    groupedClosedData[monthYearClosed]++;
                }
            }
        });

        // Preenche os arrays de labels e values com os dados agrupados
        months.forEach(function (monthYear) {
            labels.push(monthYear);
            openValues.push(groupedOpenData[monthYear]);
            closedValues.push(groupedClosedData[monthYear]);
        });

        var myChart = new Chart(ctx, {
            type: 'line', // Mudança para gráfico de linhas
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Chamados Abertos',
                        data: openValues,
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2,
                        borderCapStyle: 'round', // Arredonda as extremidades da linha
                        borderJoinStyle: 'round', // Arredonda os pontos de junção entre as linhas
                        fill: false // Remove o preenchimento abaixo da linha
                    },
                    {
                        label: 'Chamados Atendidos',
                        data: closedValues,
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 2,
                        borderCapStyle: 'round', // Arredonda as extremidades da linha
                        borderJoinStyle: 'round', // Arredonda os pontos de junção entre as linhas
                        fill: false // Remove o preenchimento abaixo da linha
                    }
                ]
            },
            options: {
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Mês/Ano'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Número de Chamados'
                        }
                    }
                }
            }
        });
    });

    function getRandomColor() {
        var letters = '0123456789ABCDEF';
        var color = '#';
        for (var i = 0; i < 6; i++) {
            color += letters[Math.floor(Math.random() * 16)];
        }
        return color;
    }
</script>