@model IEnumerable<AppSysoHelp.Models.Chamados>
@{
    ViewData["Title"] = "Home";
    var tecnicos = (List<TotalizadorChamadosPorTecnico>)ViewBag.tecnicosAtendimento;   
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="row">
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="iq-card iq-card-block iq-card-stretch ">
            <div class="iq-card-body">
                <div class="d-flex d-flex align-items-center justify-content-between">
                    <div>
                        <h2>352</h2>
                        <p class="fontsize-sm m-0">Pendentes</p>
                    </div>
                    <div class="rounded-circle iq-card-icon dark-icon-light iq-bg-primary "> <i class="ri-inbox-fill"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="iq-card iq-card-block iq-card-stretch ">
            <div class="iq-card-body">
                <div class="d-flex d-flex align-items-center justify-content-between">
                    <div>
                        <h2>$37k</h2>
                        <p class="fontsize-sm m-0">Em Atendimento</p>
                    </div>
                    <div class="rounded-circle iq-card-icon iq-bg-danger"><i class="ri-radar-line"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="iq-card iq-card-block iq-card-stretch ">
            <div class="iq-card-body">
                <div class="d-flex d-flex align-items-center justify-content-between">
                    <div>
                        <h2>32%</h2>
                        <p class="fontsize-sm m-0">Fechados</p>
                    </div>
                    <div class="rounded-circle iq-card-icon iq-bg-warning "><i class="ri-price-tag-3-line"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-3">
        <div class="iq-card iq-card-block iq-card-stretch ">
            <div class="iq-card-body">
                <div class="d-flex d-flex align-items-center justify-content-between">
                    <div>
                        <h2>27h</h2>
                        <p class="fontsize-sm m-0">Todos</p>
                    </div>
                    <div class="rounded-circle iq-card-icon iq-bg-info "><i class="ri-refund-line"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-6">
        <div class="m-2">
            <canvas id="chart"></canvas>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="m-2">
            <canvas id="myChart"></canvas>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Gráfico de atendimentos
        var ctx = document.getElementById('chart').getContext('2d');

        // Serializa os dados do modelo para JSON
        var chamadosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        // Processa e agrupa os dados por mês
        var labels = [];
        var openValues = [];
        var closedValues = [];
        var groupedOpenData = {};
        var groupedClosedData = {};
        var currentDate = new Date();
        var months = [];

        // Adiciona os últimos 6 meses ao array de meses
        for (var i = 0; i < 6; i++) {
            var monthYear = currentDate.getFullYear() + '-' + (currentDate.getMonth() + 1).toString().padStart(2, '0');
            months.unshift(monthYear);
            currentDate.setMonth(currentDate.getMonth() - 1);
        }

        // Preenche os objetos com zeros
        months.forEach(function (monthYear) {
            groupedOpenData[monthYear] = 0;
            groupedClosedData[monthYear] = 0;
        });

        // Processa os dados
        chamadosData.forEach(function (item) {
            var dateCreated = new Date(item.DataCriacao);
            var monthYearCreated = dateCreated.getFullYear() + '-' + (dateCreated.getMonth() + 1).toString().padStart(2, '0');
            if (groupedOpenData[monthYearCreated] !== undefined) {
                groupedOpenData[monthYearCreated]++;
            }

            if (item.DataFechamento) {
                var dateClosed = new Date(item.DataFechamento);
                var monthYearClosed = dateClosed.getFullYear() + '-' + (dateClosed.getMonth() + 1).toString().padStart(2, '0');
                if (groupedClosedData[monthYearClosed] !== undefined) {
                    groupedClosedData[monthYearClosed]++;
                }
            }
        });

        // Preenche labels e valores
        months.forEach(function (monthYear) {
            labels.push(monthYear);
            openValues.push(groupedOpenData[monthYear]);
            closedValues.push(groupedClosedData[monthYear]);
        });

        // Cria o gráfico de atendimentos
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Chamados Abertos',
                        data: openValues,
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2,
                        fill: false
                    },
                    {
                        label: 'Chamados Atendidos',
                        data: closedValues,
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 2,
                        fill: false
                    }
                ]
            },
            options: {
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Mês/Ano'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Número de Chamados'
                        }
                    }
                }
            }
        });

        


        var ctx2 = document.getElementById('myChart').getContext('2d');

        // Serializa os dados dos técnicos a partir do ViewBag
        var techniciansData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.tecnicosAtendimento));

        // Log para verificar a estrutura dos dados
        console.log(techniciansData);

        // Obter nomes únicos dos técnicos
        const techniciansLabels = [...new Set(techniciansData.map(t => t.NomeCompleto))];

        // Inicializa os dados por prioridade
        const technicianPrioritiesData = {
            NORMAL: Array(techniciansLabels.length).fill(0),
            MEDIA: Array(techniciansLabels.length).fill(0),
            ALTA: Array(techniciansLabels.length).fill(0),
            URGENTE: Array(techniciansLabels.length).fill(0),
        };

        // Soma os atendimentos por prioridade
        techniciansData.forEach(t => {
            const index = techniciansLabels.indexOf(t.NomeCompleto);
            if (index !== -1) { // Verifica se o técnico foi encontrado
                if (t.Prioridade === 'NORMAL') {
                    technicianPrioritiesData.NORMAL[index] += t.total;
                } else if (t.Prioridade === 'MEDIA') {
                    technicianPrioritiesData.MEDIA[index] += t.total;
                } else if (t.Prioridade === 'ALTA') {
                    technicianPrioritiesData.ALTA[index] += t.total;
                } else if (t.Prioridade === 'URGENTE') {
                    technicianPrioritiesData.URGENTE[index] += t.total;
                }
            }
        });

        // Log para verificar os dados acumulados
        console.log(technicianPrioritiesData);

        // Cria o gráfico de técnicos
        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: techniciansLabels,
                datasets: [
                    {
                        label: 'NORMAL',
                        data: technicianPrioritiesData.NORMAL,
                        backgroundColor: 'red',
                        stack: 'Stack 0'
                    },
                    {
                        label: 'MEDIA',
                        data: technicianPrioritiesData.MEDIA,
                        backgroundColor: 'yellow',
                        stack: 'Stack 0'
                    },
                    {
                        label: 'ALTA',
                        data: technicianPrioritiesData.ALTA,
                        backgroundColor: 'orange',
                        stack: 'Stack 0'
                    },
                    {
                        label: 'URGENTE',
                        data: technicianPrioritiesData.URGENTE,
                        backgroundColor: 'green',
                        stack: 'Stack 0'
                    }
                ]
            },
            options: {
                scales: {
                    x: {
                        stacked: true
                    },
                    y: {
                        stacked: true,
                        beginAtZero: true
                    }
                }
            }
        });


    });
</script>