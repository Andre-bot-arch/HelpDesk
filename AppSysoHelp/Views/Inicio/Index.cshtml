@model IEnumerable<AppSysoHelp.Models.PlataformasContratos>
﻿@{
    ViewData["Title"] = "Home Page";
    var time = ViewData["Time"] as List<Time> ?? new List<Time>();
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Syso Tecnologia</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="~/landing-page/assets/favicon.ico" />
    <!-- Font Awesome icons (free version)-->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts-->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet" type="text/css" />
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="~/landing-page/css/styles.css" rel="stylesheet" />
    <style>
        .is-invalid {
            border-color: #dc3545;
        }
    </style>
</head>
<body id="page-top">
    <!-- Navigation-->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand" href="#page-top">
                <img src="~/landing-page/images/LOGO SYSO 01.png" alt="..." style="width: 200px; height: auto;" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                Menu
                <i class="fas fa-bars ms-1"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarResponsive">
                <ul class="navbar-nav text-uppercase ms-auto py-4 py-lg-0">
                    <li class="nav-item"><a class="nav-link" href="#services">Serviços</a></li>
                    <li class="nav-item"><a class="nav-link" href="#portfolio">Portfólio</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">Sobre nós</a></li>
                    <li class="nav-item"><a class="nav-link" href="#team">Time</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contato</a></li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Home/Index" style="font-size: 18px; color: white;"><i class="fas fa-cog"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- Masthead-->
    <header class="masthead">
        <div class="container">
            <div class="masthead-subheading">Seja bem vindo!</div>
            <div class="masthead-heading text-uppercase">Syso Tecnologia</div>
            <a class="btn btn-dark btn-xl text-uppercase" href="#services">Quer saber mais</a>
        </div>
    </header>
    <!-- Services-->
    <section class="page-section" id="services">
        <div class="container">
            <div class="text-center">
                <h2 class="section-heading text-uppercase">Serviços</h2>
                <h3 class="section-subheading text-muted">Veja alguns de nossos serviços</h3>
            </div>
            <div class="row text-center">
                <div class="col-md-4">
                    <span class="fa-stack fa-4x">
                        <i class="fas fa-circle fa-stack-2x text-dark"></i>
                        <i class="fas fa-shopping-cart fa-stack-1x fa-inverse"></i>
                    </span>
                    <h4 class="my-3">E-Commerce</h4>
                    <p class="text-muted" style="text-align:justify">Bem-vindos à nossa solução de e-commerce inovadora, projetada para transformar a forma como você gerencia e expande seu negócio online. Nossa plataforma combina a robustez de um sistema de e-commerce moderno com a posibilidade de integração com a sua ERP (Enterprise Resource Planning).</p>
                </div>
                <div class="col-md-4">
                    <span class="fa-stack fa-4x">
                        <i class="fas fa-circle fa-stack-2x text-dark"></i>
                        <i class="fas fa-laptop fa-stack-1x fa-inverse"></i>
                    </span>
                    <h4 class="my-3">APP / ERP</h4>
                    <p class="text-muted" style="text-align:justify">Bem-vindo à nossa solução que une a praticidade de um aplicativo móvel à potência de um sistema ERP. Nossa plataforma é projetada para proporcionar uma gestão empresarial ágil e eficaz, oferecendo uma integração perfeita entre o seu aplicativo e o ERP da empresa.</p>
                </div>
                <div class="col-md-4">
                    <span class="fa-stack fa-4x">
                        <i class="fas fa-circle fa-stack-2x text-dark"></i>
                        <i class="fas fa-lock fa-stack-1x fa-inverse"></i>
                    </span>
                    <h4 class="my-3">Backup</h4>
                    <p class="text-muted" style="text-align:justify">Bem-vindo à nossa solução de backup robusta e confiável, projetada para garantir a integridade e a segurança dos seus dados mais preciosos. Em um mundo digital onde a proteção de informações é crucial, nosso sistema oferece uma proteção abrangente para todas as suas necessidades de backup.</p>
                </div>
            </div>
        </div>
    </section>
    <!-- Portfolio Grid-->
    <section class="page-section bg-light" id="portfolio">
        <div class="container">
            <div class="text-center">
                <h2 class="section-heading text-uppercase">Portfolio</h2>
            </div>
            <div class="row">
                @foreach (var i in Model)
                {
                    <div class="col-lg-4 col-sm-6 mb-4">
                        <!-- Portfolio item 1-->
                        <div class="portfolio-item">
                            <a class="portfolio-link d-flex justify-content-center align-items-center" data-bs-toggle="modal" href="#portfolioModal" style="min-height: 300px;" data-titulo="@i.NomePlataforma" data-descricao="@i.Descricao" data-imagem="@i.CaminhoImagem">
                                <div class="portfolio-hover">
                                    <div class="portfolio-hover-content"><i class="fas fa-plus fa-3x"></i></div>
                                </div>
                                <img class="img-fluid" src="@i.CaminhoImagem" alt="..." style="max-width: 100%; max-height: 300px;" />
                            </a>
                            <div class="portfolio-caption">
                                <div class="portfolio-caption-heading">@i.NomePlataforma</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- About-->
    <section class="page-section" id="about">
        <div class="container">
            <div class="text-center">
                <h2 class="section-heading text-uppercase">Sobre</h2>
                <h3 class="section-subheading text-muted">Conheça um pouco da nossa história.</h3>
            </div>
            <ul class="timeline">
                <li>
                    <div class="timeline-image"><img class="rounded-circle img-fluid" src="~/landing-page/assets/img/about/1.jpg" alt="..." /></div>
                    <div class="timeline-panel">
                        <div class="timeline-heading">
                            @* <h4>2009-2011</h4> *@
                            <h4 class="subheading">Missão</h4>
                        </div>
                        <div class="timeline-body">
                            <p class="text-muted">
                                Nossa missão é transformar o potencial da tecnologia em soluções inovadoras que capacitam indivíduos e empresas a alcançarem seus objetivos. Buscamos desenvolver produtos e serviços que não apenas atendam às necessidades atuais dos nossos clientes, mas que também antecipem as demandas do futuro, promovendo eficiência, segurança e sustentabilidade.
                                @* Valorizamos a inovação contínua e a excelência no atendimento ao cliente, criando um ambiente colaborativo onde ideias se transformam em realidade. Comprometemo-nos a construir um mundo mais conectado e inteligente, capacitando nossos clientes a prosperarem em um cenário tecnológico em constante evolução. *@
                            </p>
                        </div>
                    </div>
                </li>
                <li class="timeline-inverted">
                    <div class="timeline-image"><img class="rounded-circle img-fluid" src="~/landing-page/assets/img/about/2.jpg" alt="..." /></div>
                    <div class="timeline-panel">
                        <div class="timeline-heading">
                            @* <h4>March 2011</h4> *@
                            <h4 class="subheading">Visão</h4>
                        </div>
                        <div class="timeline-body"><p class="text-muted">Ser reconhecida como líder em inovação tecnológica, moldando o futuro através de soluções que transformam a forma como as pessoas e as empresas interagem com a tecnologia. Aspiramos a criar um ecossistema onde a tecnologia é acessível e intuitiva, impulsionando a transformação digital em todos os setores.</p></div>
                    </div>
                </li>
                <li>
                    <div class="timeline-image"><img class="rounded-circle img-fluid" src="~/landing-page/assets/img/about/3.jpg" alt="..." /></div>
                    <div class="timeline-panel">
                        <div class="timeline-heading">
                            @* <h4>December 2015</h4> *@
                            <h4 class="subheading">Valores</h4>
                        </div>
                        <div class="timeline-body"><p class="text-muted">Nossos valores são a base do que fazemos. Acreditamos na inovação constante, buscando sempre novas ideias e soluções. Comprometemo-nos a oferecer produtos e serviços de alta qualidade, agindo com ética e transparência em todas as nossas interações. Valorizamos a colaboração e a diversidade de opiniões, sempre colocando nossos clientes em primeiro lugar e atendendo suas necessidades. Também buscamos práticas que respeitem o meio ambiente e acreditamos na importância do crescimento e do aprendizado contínuo.</p></div>
                    </div>
                </li>
                @* <li class="timeline-inverted">
                <div class="timeline-image"><img class="rounded-circle img-fluid" src="~/landing-page/assets/img/about/4.jpg" alt="..." /></div>
                <div class="timeline-panel">
                <div class="timeline-heading">
                <h4>July 2020</h4>
                <h4 class="subheading">Valores</h4>
                </div>
                </div>
                </li> *@
                <li class="timeline-inverted">
                    <div class="timeline-image">
                        <h4>
                            Faça parte
                            <br />
                            Da Nossa
                            <br />
                            História!
                        </h4>
                    </div>
                </li>
            </ul>
        </div>
    </section>
    <!-- Team-->
    <section class="page-section bg-light" id="team">
        <div class="container">
            <div class="text-center">
                <h2 class="section-heading text-uppercase">Nossa incrível equipe</h2>
                @*<h3 class="section-subheading text-muted">Lorem ipsum dolor sit amet consectetur.</h3>*@
            </div>
            <div class="row">
                @foreach (var item in time)
                {
                    <div class="col-lg-4">
                        <div class="team-member">
                            <img class="mx-auto rounded-circle" src="@item.CaminhoImagem" alt="..." />
                            <h4>@item.Nome</h4>
                            <p class="text-muted">@item.Funcao</p>
                            <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Parveen Anand Twitter Profile"><i class="fab fa-instagram"></i></a>
                            <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Parveen Anand Facebook Profile"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Parveen Anand LinkedIn Profile"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                }
            </div>
            @*<div class="row">
                <div class="col-lg-8 mx-auto text-center"><p class="large text-muted">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aut eaque, laboriosam veritatis, quos non quis ad perspiciatis, totam corporis ea, alias ut unde.</p></div>
            </div>*@
        </div>
    </section>
    <!-- Clients-->
    @*<div class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src="~/landing-page/assets/img/logos/microsoft.svg" alt="..." aria-label="Microsoft Logo" /></a>
                </div>
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src="~/landing-page/assets/img/logos/google.svg" alt="..." aria-label="Google Logo" /></a>
                </div>
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src="~/landing-page/assets/img/logos/facebook.svg" alt="..." aria-label="Facebook Logo" /></a>
                </div>
                <div class="col-md-3 col-sm-6 my-3">
                    <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src="~/landing-page/assets/img/logos/ibm.svg" alt="..." aria-label="IBM Logo" /></a>
                </div>
            </div>
        </div>
    </div>*@
    <!-- Contact-->
    <section class="page-section" id="contact">
        <div class="container">
            <div class="text-center">
                <h2 class="section-heading text-uppercase">Entre em Contato!</h2>
                <h3 class="section-subheading text-white">Você pode entrar em contato conosco pelo formulário abaixo.</h3>
            </div>
            <form id="contactForm">
                <div class="row align-items-stretch mb-5">
                    <div class="col-md-6">
                        <div class="form-group">
                            <!-- Name input-->
                            <input class="form-control is-invalid" id="name" type="text" name="Name" placeholder="Seu nome *" />
                        </div>
                        <div class="form-group">
                            <!-- Email address input-->
                            <input class="form-control is-invalid" id="email" type="email" name="Email" placeholder="Seu melhor email *" />
                        </div>
                        <div class="form-group mb-md-0">
                            <!-- Phone number input-->
                            <input class="form-control is-invalid" id="phone" name="Phone" type="tel" placeholder="Seu telefone *" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group form-group-textarea mb-md-0">
                            <!-- Message input-->
                            <textarea class="form-control is-invalid" id="message" name="Message" placeholder="Sua mensagem *"></textarea>
                        </div>
                    </div>
                </div>
                <div class="text-center"><button class="btn btn-primary btn-xl text-uppercase" id="btnEnviarForm" type="submit">Enviar Mensagem</button></div>
            </form>
        </div>
    </section>
    <!-- Footer-->
    <footer class="footer py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 text-lg-start">Copyright &copy; Syso Tecnologia 2024</div>
                <div class="col-lg-4 my-3 my-lg-0">
                    <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a class="btn btn-dark btn-social mx-2" href="#!" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="link-dark text-decoration-none me-3" href="#!">Políticas de Privacidade</a>
                    @* <a class="link-dark text-decoration-none" href="#!">Terms of Use</a> *@
                </div>
            </div>
        </div>
    </footer>
    <!-- Portfolio Modals-->
    <!-- Portfolio item 1 modal popup-->
    <div class="portfolio-modal modal fade" id="portfolioModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="close-modal" data-bs-dismiss="modal"><img src="~/landing-page/assets/img/close-icon.svg" alt="Close modal" /></div>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="modal-body">
                                <!-- Project details-->
                                <h2 class="text-uppercase" id="modalTitle"></h2>
                                <p class="item-intro text-muted" id="modalDescription"></p>
                                <img class="img-fluid d-block mx-auto" id="modalImage" src="" alt="Project Image" style="max-width: 100%; max-height: 400px;" />
                                <p id="modalDescription"></p>
                                <ul class="list-inline">
                                    <li>
                                        @* <strong>Clientes que usam:</strong>
                                        <span id="modalClient">Teste, Teste</span> *@
                                    </li>
                                </ul>
                                <button class="btn btn-primary btn-xl text-uppercase" data-bs-dismiss="modal" type="button">
                                    <i class="fas fa-xmark me-1"></i>
                                    Fechar Projeto
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/landing-page/js/scripts.js"></script>
    <script src="~/landing-page/js/contato.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
    <script>
        $(document).ready(function () {
            $('#portfolioModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // O elemento que acionou o modal
                var titulo = button.data('titulo');
                var descricao = button.data('descricao');
                var imagem = button.data('imagem');

                // Atualiza o conteúdo do modal
                $('#modalTitle').text(titulo);
                $('#modalDescription').text(descricao);
                $('#modalImage').attr('src', imagem);
            });
        });
    </script>
</body>
</html>