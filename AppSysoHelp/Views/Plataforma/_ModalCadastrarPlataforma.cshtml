<div id="modalCadastrarPlataforma" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="modalCadastrarPlataforma" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header position-sticky top-0 bg-white">
                <h5 class="modal-title" id="modalCadastrarPlataforma">Cadastrar Plataforma</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form id="formCadastrarPlataforma" class="was-validated" enctype="multipart/form-data">
                <div class="modal-body" style="max-height: 400px; overflow-y: auto;">
                    <!-- Nome da Plataforma -->
                    <div class="form-group">
                        <div class="mb-3">
                            <input name="NomePlataforma" type="text" maxlength="100" class="form-control" id="NomePlataforma" placeholder="Nome da Plataforma" required>
                        </div>
                    </div>
                    <!-- Descrição -->
                    <div class="form-group">
                        <div class="mb-3">
                            <textarea name="Descricao" maxlength="500" rows="3" class="form-control" id="Descricao" placeholder="Detalhes da Plataforma" required></textarea>
                        </div>
                    </div>
                    <!-- Imagem -->
                    <div class="form-group">
                        <label for="imagemPlataforma">Imagem da Plataforma</label>
                        <input type="file" class="form-control-file" id="imagemBase64Cadastrar" name="imagemBase64" accept="image/*" required>
                    </div>
                    <!-- Pré-visualização da Imagem -->
                    <div class="form-group">
                        <label>Pré-visualização:</label>
                        <img id="previewImagemCadastrar" src="#" alt="Pré-visualização" style="display: none; max-width: 50%; height: auto;" />
                    </div>
                </div>
                <div class="modal-footer position-sticky bottom-0 bg-white">
                    <button type="button" style="width: 80px" class="btn btn-danger" data-dismiss="modal">Sair</button>
                    <button type="button" id="btnSalvar" style="width: 80px" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>