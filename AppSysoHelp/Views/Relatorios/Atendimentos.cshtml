@model IEnumerable<AppSysoHelp.Models.VwAtendimentos>

<style>
    /* Tornar as letras do DataTable brancas */
    #myTable, #myTable th, #myTable td {
        color: white;
    }
    /* Fundo para destacar as letras brancas */
    #myTable {
        background-color: #222;
    }
    /* Ajustar os botões do DataTables */
    .dt-button {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        margin-right: 5px;
    }

        .dt-button:hover {
            background-color: #0056b3;
        }
</style>

<div class="row align-items-center mb-3">
    <div class="col-sm-2">
        <input class="form-control filter-input" data-column="0" type="text" placeholder="Protocolo">
    </div>
    <div class="col-sm-2">
        <input class="form-control filter-input" data-column="1" type="text" placeholder="Cliente">
    </div>
    <div class="col-sm-2">
        <input class="form-control filter-input" data-column="2" type="text" placeholder="Técnico">
    </div>
    <div class="col-sm-2">
        <input class="form-control filter-input" data-column="3" type="text" placeholder="Situação">
    </div>
    <div class="col-sm-2">
        <input class="form-control filter-input" data-column="4" type="text" placeholder="Categoria">
    </div>
    <div class="col-sm-2">
        <input class="form-control filter-input" data-column="5" type="text" placeholder="SubCategoria">
    </div>
</div>


<div id="tabela-container">
    <div class="table-responsive">
        <table id="myTable" class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Técnico</th>
                    <th>Situação</th>
                    <th>Categoria</th>
                    <th>SubCategoria</th>
                    <th>Motivo Abertura</th>
                    <th>Descrição Atendimento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProtocoloChamado</td>
                        <td>@item.Cliente</td>
                        <td>@item.Tecnico</td>
                        <td>@item.Situacao</td>
                        <td>@item.Categoria</td>
                        <td>@item.SubCategoria</td>
                        <td>@item.MotivoAbertura</td>
                        <td>@item.ProcedimentosAplicados</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script>
        // Inicializar DataTable
        let table = new DataTable('#myTable', {
            language: {
                url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
            },
            dom: 'Bfrtip', // Adiciona botões na interface
            buttons: [
                {
                    extend: 'csvHtml5',
                    text: 'Exportar CSV'
                },
                {
                    extend: 'excelHtml5',
                    text: 'Exportar XLSX',
                    title: 'DadosExportados' // Nome do arquivo exportado
                },
                {
                    extend: 'print',
                    text: 'Imprimir'
                }
            ]
        });

        // Adicionar listener nos inputs
        document.querySelectorAll('.filter-input').forEach(input => {
            input.addEventListener('input', function () {
                let columnIndex = this.getAttribute('data-column');
                table.columns(columnIndex).search(this.value).draw();
            });
        });
    </script>
}