@model AppSysoHelp.Models.ChamadosSubCategoria


<div class="modal-body">
    <input type="hidden" asp-for="SubCategoriaId" />
    <div class="form-group">
        <div class="mb-3">
            <input type="text" autocomplete="off" asp-for="Descricao" name="Descricao" id="_Descricao" maxlength="100" class="form-control is-invalid" placeholder="Nome da categoria" required>
        </div>
    </div>
    <div class="form-group">
        <select class="custom-select" asp-for="Prioridade" name="Prioridade" required="">
            <option value="">Selecione uma Prioridade</option>
            <option class="text-dark" value="Normal">NORMAL</option>
            <option class="text-warning" value="Media">MEDIA</option>
            <option class="text-danger" value="Alta">ALTA  </option>
            <option value="Urgente">URGENTE</option>
        </select>
    </div>
    <div class="form-group">
        <select class="custom-select" asp-for="Complexidade" name="Complexidade" required="">
            <option value="">Selecione a Complexidade</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </select>
    </div>
</div>

<div class="modal-footer">
    <button type="button" style="width: 80px" class="btn btn-danger" data-dismiss="modal">sair</button>
    <button type="button" style="width: 80px" class="btn btn-primary btn-editarSalvar-sub">Salvar</button>
</div>

<script src="~/assets/js/categoria.js" charset="UTF-8"></script>