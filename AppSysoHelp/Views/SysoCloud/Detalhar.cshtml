@model AppSysoHelp.Models.Contratos
@{
    var contrato = Model;
    int usados = Model.Licencas.Sum(licenca => licenca.Dispositivos.Count);
    List<SysoCloud> eventos = ViewBag.Eventos ?? new List<SysoCloud>();
}
<style>

    /* Cor de fundo das linhas ímpares */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #111b21;
    }

    /* Cor de fundo das linhas pares */
    .table-striped tbody tr:nth-of-type(even) {
        background-color: #222e35;
    }

    /* Cor do texto para garantir legibilidade */
    .table-striped tbody tr {
        color: #ffffff; /* Muda a cor do texto para branco */
    }

    /* Bordas arredondadas */
    .table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th:first-child {
            border-top-left-radius: 10px;
        }

        .table thead th:last-child {
            border-top-right-radius: 10px;
        }

        .table tbody tr:last-child td:first-child {
            border-bottom-left-radius: 10px;
        }

        .table tbody tr:last-child td:last-child {
            border-bottom-right-radius: 10px;
        }
</style>

<div class="row">
    <div class="col-sm-12 mt-5">
        <div class="iq-card" style="background-color: #111b21">
            <div class="iq-card-body profile-page p-0">
                <div class="profile-header">
                    <div class="profile-info p-4">
                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="user-detail pl-5">
                                    <div class="d-flex flex-wrap align-items-center">
                                        <div class="profile-img pr-4">
                                            <img src="~/images/helpdesk/_logo.png" alt="profile-img" class="avatar-130 img-fluid">
                                        </div>
                                        <div class="profile-detail">
                                            <h5 class="text-primary">@Model.DescricaoContrato</h5>
                                            <h6 class="text-primary">Cliente: @Model.FkCliente?.NomeCliente</h6>
                                            <input type="hidden" asp-for="@Model.ContratoId" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="iq-card iq-card-block iq-card-stretch iq-card-height" style="background-color: #222e35">
                <div class="iq-card-header d-flex justify-content-between">
                    <div class="iq-header-title">
                        <h6 class="text-primary card-title">Eventos</h6>
                    </div>
                    <div class="iq-card-header-toolbar d-flex align-items-center">
                        <a href="~/SysoCloud/Index" class="btn dark-icon btn-light m-1">Voltar <i class="ri-reply-line"></i></a>
                        <button type="button" data-toggle="modal" data-target="#cadastroDeEvento" class="btn dark-icon btn-primary m-1">Adicionar <i class="ri-add-box-line"></i></button>
                    </div>
                </div>
                <div class="iq-card-body">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0 table-borderless" style="border-color: #222e35; ">
                            <thead>
                                <tr sstyle="border-bottom: 1px solid #222e35;">
                                    <th scope="col">#</th>
                                    <th scope="col">Descricao</th>
                                    <th scope="col">Caminho Script</th>
                                    <th scope="col">Caminho Download</th>
                                    <th scope="col">Caminho Upload</th>
                                    <th scope="col">Caminho Buscar Arquivo</th>
                                    <th scope="col">Data Criação</th>
                                    <th scope="col">TIPO</th>
                                    <th scope="col">AÇÃO</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in eventos)
                                {
                                    <tr>
                                        <td>@item.PkId.ToString().PadLeft(4, '0')</td>
                                        <td>@item.Descricao</td>
                                        <td>@item.ExecutarAntesBackup</td>
                                        <td>@item.CaminhoDownload</td>
                                        <td>@item.CaminhoUpload</td>
                                        <td>@item.CaminhoBuscaArquivo</td>
                                        <td>@item.DataCreate</td>
                                        <td>@item.TipoBackup</td>
                                        <td>@item.ExecutarAposBackup</td>
                                        <td><a class="btn dark-icon btn-danger" asp-action="Delete" asp-controller="SysoCloud" asp-route-id="@item.PkId">Excluir</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<partial name="_ModalCadastrarEvento.cshtml" />

