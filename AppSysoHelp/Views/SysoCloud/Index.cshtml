@model IEnumerable<AppSysoHelp.Models.Contratos>
@{
}
<div class="iq-card" style="background-color: #0B141A">
    <div class="iq-card-header d-flex justify-content-between">
        <div class="iq-header-title">
            <h4 class="text-primary">Contratos SysoCloud Ativos</h4>
        </div>
    </div>
    <div class="iq-card-body">
        <div class="row">
            @foreach (var item in Model.GroupBy(a => a.FkClienteId))
            {
                <div class="container mb-3">
                    <div class="card" style="background-color: #222e35">
                        <div class="card-header text-primary" style="background-color: #111b21">
                            <i class="fa fa-address-book"></i> @item.FirstOrDefault()?.FkCliente?.NomeCliente.ToUpper()
                        </div>
                        <div class="card-body">
                            @foreach (var contrato in item)
                            {
                                var situacao = "text-primary";
                                if (contrato.SituacaoContrato == "Inativo")
                                {
                                    situacao = "text-danger";
                                }
                                <div class="row align-items-center">
                                    <div class="col-7">
                                        <label class="card-title @situacao">
                                            <span class="@situacao">@contrato.FkPlataforma.NomePlataforma:</span> @contrato.FkPlataforma.Descricao
                                            <br />
                                            <span class="@situacao">Pontos: @contrato.PontosContratados</span>
                                        </label>
                                    </div>
                                    <div class="col-5 d-flex justify-content-end">
                                        <a id="downloadBtn" data-id="@contrato.ContratoId" style="width: 140px; color: white" class="btn dark-icon btn-success mr-3"><i class="las la-download"></i>Exportar Txt</a>
                                        <a asp-action="Detalhar" asp-controller="SysoCloud" asp-route-id="@contrato.ContratoId" class="btn dark-icon btn-primary" data-id="@contrato.ContratoId">Detalhar <i class="ri-edit-box-fill"></i></a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <hr />
            }
        </div>

    </div>
</div>

<script>
    $(document).ready(function() {
        $('#downloadBtn').on('click', function() {
        var contratoId = $(this).data('id'); // Obtém o valor do data-id

        // Função para criar e clicar dinamicamente em um link
        function createAndClickLink(url) {
            var link = document.createElement('a');
            link.href = url;
            link.download = ''; // O atributo download é usado para iniciar o download
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // URLs dos arquivos para download
        var urls = [
            '@Url.Action("GerarEmailTxt", "SysoCloud")',
            '@Url.Action("GerarEmpresaTxt", "SysoCloud", new { contratoId = "__contratoId__" })'.replace('__contratoId__', contratoId),
            '@Url.Action("GerarEventoTxt", "SysoCloud", new { contratoId = "__contratoId__" })'.replace('__contratoId__', contratoId)
        ];

        // Iniciar download para cada URL
        urls.forEach(function(url) {
            createAndClickLink(url);
        });
    });
    });
</script>
