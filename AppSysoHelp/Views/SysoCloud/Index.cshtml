@using X.Web.PagedList
@model X.PagedList.IPagedList<AppSysoHelp.Models.Contratos>
@{
    var query = ViewBag.Query;
    int currentPage = Model.PageNumber;
    int totalPages = Model.PageCount;
    int maxPagesToShow = 7; // Total de páginas a mostrar (3 para frente + 3 para trás + a página atual)
    int startPage = Math.Max(1, currentPage - 3);
    int endPage = Math.Min(totalPages, currentPage + 3);

    // Ajuste para mostrar o número correto de páginas quando há menos páginas no início ou no final
    if (endPage - startPage + 1 < maxPagesToShow)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(totalPages, endPage + (maxPagesToShow - (endPage - startPage + 1)));
        }
        else if (endPage == totalPages)
        {
            startPage = Math.Max(1, startPage - (maxPagesToShow - (endPage - startPage + 1)));
        }
    }
}
<div class="iq-card" style="background-color: #0B141A">
    <div class="iq-card-header d-flex justify-content-between align-items-center">
        <div class="iq-header-title">
            <h4 class="card-title text-white">Contratos SysoCloud Ativos</h4>
        </div>
        <form asp-action="Index" asp-controller="SysoCloud" class="d-flex align-items-center mx-auto">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Buscar cliente..." name="query" aria-label="Buscar cliente..." aria-describedby="button-addon2" style="border-color: #6546D2">
                <div class="input-group-append">
                    <button class="btn btn-outline-primary" type="submit" id="button-addon2" style="font-weight: bold; font-size: 1.3rem">
                        <i class="las la-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <div class="iq-card-body">
        <div class="row">
            @foreach (var item in Model.GroupBy(a => a.FkClienteId))
            {
                <div class="container mb-3">
                    <div class="card" style="background-color: #222e35">
                        <div class="card-header text-white cliente-nome" style="background-color: #394247; font-size: 16px;">
                            <i class="fa fa-address-book"></i> @item.FirstOrDefault()?.FkCliente?.Fantasia.ToUpper() - <span style="font-size: 11px; ">@item.FirstOrDefault()?.FkCliente?.NomeCliente.ToUpper()</span>
                        </div>
                        <div class="card-body">
                            @foreach (var contrato in item)
                            {
                                var situacao = "text-primary";
                                if (contrato.SituacaoContrato == "Inativo")
                                {
                                    situacao = "text-danger";
                                }
                                <div class="row align-items-center">
                                    <div class="col-7">
                                        <label class="card-title @situacao">
                                            <span class="@situacao">@contrato.FkPlataforma.NomePlataforma:</span> @contrato.FkPlataforma.Descricao
                                            <br />
                                            <span class="@situacao">Pontos: @contrato.PontosContratados</span>
                                        </label>
                                    </div>
                                    <div class="col-5 d-flex justify-content-end">
                                        <a id="downloadBtn" data-id="@contrato.ContratoId" style="width: 140px; color: white" class="btn dark-icon btn-success mr-3"><i class="las la-download"></i>Exportar Txt</a>
                                        <a asp-action="Detalhar" asp-controller="SysoCloud" asp-route-id="@contrato.ContratoId" class="btn dark-icon btn-primary" data-id="@contrato.ContratoId">Detalhar <i class="ri-edit-box-fill"></i></a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <hr />
            }
        </div>
    </div>
</div>
<!-- Aqui ficam os botões de paginação -->
<div class="d-flex justify-content-center">
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber - 1, query = query })">Anterior</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Anterior</span>
            </li>
        }

        @if (startPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, query = query })">1</a>
            </li>
            @if (startPage > 2)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i, query = query })">@i</a>
            </li>
        }

        @if (endPage < totalPages)
        {
            @if (endPage < totalPages - 1)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = totalPages, query = query })">@totalPages</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = Model.PageNumber + 1, query = query })">Próxima</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Próxima</span>
            </li>
        }
    </ul>
</div>

<script>
    $(document).ready(function () {
        $('#downloadBtn').on('click', function () {
            var contratoId = $(this).data('id'); // Obtém o valor do data-id

            // Função para criar e clicar dinamicamente em um link
            function createAndClickLink(url) {
                var link = document.createElement('a');
                link.href = url;
                link.download = ''; // O atributo download é usado para iniciar o download
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            // URLs dos arquivos para download
            var urls = [
                '@Url.Action("GerarEmailTxt", "SysoCloud")',
                '@Url.Action("GerarEmpresaTxt", "SysoCloud", new { contratoId = "__contratoId__" })'.replace('__contratoId__', contratoId),
                '@Url.Action("GerarEventoTxt", "SysoCloud", new { contratoId = "__contratoId__" })'.replace('__contratoId__', contratoId)
            ];

            // Iniciar download para cada URL
            urls.forEach(function (url) {
                createAndClickLink(url);
            });
        });
    });
</script>
<script src="~/assets/js/contrato.js"></script>
