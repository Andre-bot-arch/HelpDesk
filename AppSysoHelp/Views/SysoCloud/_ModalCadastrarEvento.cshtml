
<style>
    .modal-body {
        max-height: 550px;
        overflow-y: auto;
    }
</style>
<div id="cadastroDeEvento" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenteredScrollableTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenteredScrollableTitle">Configuração de Backup</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form class="was-validated" asp-action="Create" asp-controller="SysoCloud" id="configurarBackup">
                <input type="hidden" name="FkClienteId" value="@Model.FkClienteId" />
                <input type="hidden" name="FkContratoId" value="@Model.ContratoId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Descrição</label>
                        <input type="text" class="form-control is-invalid" name="Descricao" id="Descricao" required>
                    </div>
                    <div class="mb-3">
                        <label>Horário</label>
                        <input type="time" class="form-control is-invalid" name="Horario" id="Horario" required>
                    </div>
                    <div class="mb-3">
                        <label>Tipo de Backup</label>
                        <div class="d-flex flex-wrap">
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="radio" name="TipoBackup" id="fbk" value="FBK" checked>
                                <label class="form-check-label" for="fbk">FBK</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="radio" name="TipoBackup" id="fdb" value="FDB">
                                <label class="form-check-label" for="fdb">FDB</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="TipoBackup" id="arquivo" value="ARQUIVO">
                                <label class="form-check-label" for="arquivo">Arquivo</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Extensões</label>
                        <input type="text" class="form-control is-invalid" name="Extensao" id="Extensoes" placeholder=".rar,.zip,.fdb" required>
                    </div>
                    <div class="mb-3">
                        <label>Caminho Download</label>
                        <input type="text" class="form-control is-invalid" name="CaminhoDownload" id="CaminhoDownload" required>
                    </div>
                    <div class="mb-3">
                        <label>Caminho Upload</label>
                        <input type="text" class="form-control is-invalid" name="CaminhoUpload" id="CaminhoUpload" required>
                    </div>
                    <div class="mb-3">
                        <label>Caminho Para Buscar os Arquivos</label>
                        <input type="text" class="form-control is-invalid" name="CaminhoBuscaArquivo" id="CaminhoBuscarArquivos" required>
                    </div>
                    <div class="mb-3">
                        <label>Executar Antes do Backup</label>
                        <input type="text" class="form-control is-invalid" name="ExecutarAntesBackup" id="ExecutarAntes" required>
                    </div>
                    <div class="mb-3">
                        <label>Dias</label>
                        <div class="d-flex flex-wrap">
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="checkbox" name="Segunda" id="segunda" value="true">
                                <input type="hidden" name="Segunda" value="false">
                                <label class="form-check-label" for="segunda">Segunda</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="checkbox" name="Terca" id="terca" value="true">
                                <input type="hidden" name="Terca" value="false">
                                <label class="form-check-label" for="terca">Terça</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="checkbox" name="Quarta" id="quarta" value="true">
                                <input type="hidden" name="Quarta" value="false">
                                <label class="form-check-label" for="quarta">Quarta</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="checkbox" name="Quinta" id="quinta" value="true">
                                <input type="hidden" name="Quinta" value="false">
                                <label class="form-check-label" for="quinta">Quinta</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="checkbox" name="Sexta" id="sexta" value="true">
                                <input type="hidden" name="Sexta" value="false">
                                <label class="form-check-label" for="sexta">Sexta</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="checkbox" name="Sabado" id="sabado" value="true">
                                <input type="hidden" name="Sabado" value="false">
                                <label class="form-check-label" for="sabado">Sábado</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Domingo" id="domingo" value="true">
                                <input type="hidden" name="Domingo" value="false">
                                <label class="form-check-label" for="domingo">Domingo</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>Executar Após o Backup</label>
                        <div class="d-flex flex-wrap">
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="radio" name="ExecutarAposBackup" id="naoDesligar" value="NAO" checked>
                                <label class="form-check-label" for="naoDesligar">Não Desligar</label>
                            </div>
                            <div class="form-check mr-3">
                                <input class="form-check-input" type="radio" name="ExecutarAposBackup" id="desligar" value="SIM">
                                <label class="form-check-label" for="desligar">Desligar</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="ExecutarAposBackup" id="reiniciar" value="REI">
                                <label class="form-check-label" for="reiniciar">Reiniciar</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" style="width: 80px" class="btn btn-danger" data-dismiss="modal">Sair</button>
                    <button type="submit" style="width: 80px" class="btn btn-primary">Gravar</button>
                </div>
            </form>
        </div>
    </div>
</div>


